# AICP workbench origin (Vue app). Required in production when marketing site ≠ workbench host.
# Local default when unset in DEV: http://localhost:8080
VITE_AICP_WORKBENCH_URL=http://localhost:8080

# Optional absolute origin for new-api public links (/dashboard, /pricing).
# Leave empty to use same-origin relative paths (typical when this site is served from new-api).
# VITE_NEW_API_PUBLIC_URL=https://api.example.com

# Backend API proxy target for rsbuild dev server
# VITE_REACT_APP_SERVER_URL=http://localhost:3001
