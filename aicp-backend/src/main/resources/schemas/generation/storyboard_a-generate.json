{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard A-tier Generate Output",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shots"],
        "properties": {
          "scene_no": { "type": "integer" },
          "dramatic_goal": { "type": "string" },
          "beat_description": { "type": "string" },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["shot_no", "description"],
              "properties": {
                "shot_no": { "type": "integer" },
                "shot_type": { "type": "string" },
                "duration_sec": { "type": "integer" },
                "description": { "type": "string" },
                "camera_action": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "total_shots": { "type": "integer" },
    "estimated_duration_sec": { "type": "integer" }
  }
}
